# Database (use 127.0.0.1 on Windows to avoid IPv6 ::1 resolution issues)
DATABASE_URL="postgresql://trusthire:trusthire_secret_2024@127.0.0.1:5432/trusthire?schema=public"

# JWT - generate strong secrets: openssl rand -hex 32
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# App
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# AWS S3 (for resume storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=trusthire-resumes

# Email (Resend)
RESEND_API_KEY=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Encryption - 64 hex chars (32 bytes)
ENCRYPTION_KEY=""
